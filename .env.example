# Copy to .env for local development. Never commit .env.

# Database. Local dev can use SQLite; production must be Postgres (survives restarts and redeploys).
# Use the direct (non-pooled) Neon connection string. postgresql://... is fine; the app adds the psycopg driver itself.
DATABASE_URL=sqlite:///./local.db

# Shared secret Vapi sends with every webhook. Set the same value (1) on the server,
# (2) in a Vapi Bearer Token credential (Integrations > Server Configuration), and
# (3) in your local .env, so scripts/push_assistant.py can add it as the X-Webhook-Token header.
VAPI_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Only used by scripts/push_assistant.py (run from your own machine), not by the server.
VAPI_API_KEY=
VAPI_CREDENTIAL_ID=
VAPI_ASSISTANT_ID=
PUBLIC_BASE_URL=https://voice-agent-mvx9.onrender.com

# Optional key for the REST API (header X-API-Key). Leave empty to keep the API open for reviewers.
API_KEY=

LOG_LEVEL=INFO
