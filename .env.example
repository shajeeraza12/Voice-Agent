# Copy to .env for local development. Never commit .env.

# Database. Local dev can use SQLite; production must be Postgres (survives restarts and redeploys).
# Railway injects DATABASE_URL as postgresql://...; the app adds the psycopg driver automatically.
DATABASE_URL=sqlite:///./local.db

# Shared secret Vapi sends with every webhook. Create a Bearer Token credential in the Vapi
# dashboard (Integrations > Server Configuration) with this same value.
VAPI_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Only used by scripts/push_assistant.py (run from your own machine), not by the server.
VAPI_API_KEY=
VAPI_CREDENTIAL_ID=
VAPI_ASSISTANT_ID=
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Optional key for the REST API (header X-API-Key). Leave empty to keep the API open for reviewers.
API_KEY=

LOG_LEVEL=INFO
